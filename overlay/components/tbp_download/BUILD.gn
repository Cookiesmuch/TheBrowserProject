import("//testing/test.gni")

# TheBrowserProject's in-house download engine.
#
# This is a standalone engine, deliberately independent of //components/download
# (Chromium's own download stack). It owns its task model, scheduling, disk
# writes and persistence; Chromium supplies only the HTTP/TLS transport via
# //net and the threading primitives from //base.

source_set("tbp_download") {
  sources = [
    "tbp_chunk_fetcher.h",
    "tbp_chunk_scheduler.cc",
    "tbp_chunk_scheduler.h",
    "tbp_disk_writer.h",
    "tbp_download_state.cc",
    "tbp_download_state.h",
    "tbp_sector_aligned_writer.cc",
    "tbp_sector_aligned_writer.h",
    "torrent/tbp_bencode.cc",
    "torrent/tbp_bencode.h",
    "torrent/tbp_torrent_metadata.cc",
    "torrent/tbp_torrent_metadata.h",
  ]

  deps = [ "//base" ]

  # The disk writer is Win32 all the way down — unbuffered handles, volume
  # sector geometry, SeManageVolumePrivilege. There is no portable subset worth
  # abstracting, and this browser targets Windows, so the implementation is
  # simply Windows-only rather than hidden behind a shim.
  if (is_win) {
    sources += [ "tbp_disk_writer_win.cc" ]
  }
}

# A dedicated test binary rather than folding these into components_unittests.
#
# components_unittests is a ~2000-target build that pulls in most of //components
# and much of //content. Our tests have no reason to wait on any of that, so a
# small standalone binary keeps the local verification loop cheap (CI itself now
# only runs on merge candidates, not every push — see ci.yml). It also means
# Phase 0 needs *zero* patches to Chromium's own files: this target is built
# directly by label rather than being registered in an upstream deps list.
test("tbp_download_unittests") {
  sources = [
    "tbp_chunk_scheduler_unittest.cc",
    "tbp_download_state_unittest.cc",
    "torrent/tbp_bencode_unittest.cc",
    "torrent/tbp_torrent_metadata_unittest.cc",
  ]

  if (is_win) {
    sources += [
      "tbp_disk_writer_unittest.cc",
      "tbp_sector_aligned_writer_unittest.cc",
    ]
  }

  deps = [
    ":tbp_download",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
  ]
}
