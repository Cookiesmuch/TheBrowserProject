# Split out from //components/tbp_download itself deliberately: this target
# depends on //chrome/browser, //content/public/browser and the network
# service mojom -- real, heavy Chromium browser-process integration -- while
# the core engine (scheduler, disk writer, resume state, DownloadTask) stays
# dependency-light and unit-testable without any of that. Nothing in
# ../BUILD.gn's tbp_download target depends on this one; callers in the
# actual browser wire the two together (not yet done -- this is the network
# layer only, the DownloadFileFactory hook that would use it is separate).
source_set("tbp_download_network") {
  sources = [
    "tbp_egress_route.h",
    "tbp_egress_router.h",
    "tbp_egress_router_impl.cc",
    "tbp_egress_router_impl.h",
    "tbp_http_chunk_fetcher.cc",
    "tbp_http_chunk_fetcher.h",
  ]

  deps = [
    "//base",
    "//chrome/browser",
    "//components/tbp_download",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}
